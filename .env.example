# LinkedIn OAuth app (https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must match an Authorized Redirect URL in the LinkedIn app exactly.
# Local (vercel dev):  http://localhost:3000/api/callback
# Production (Vercel): https://<your-app>.vercel.app/api/callback
LINKEDIN_REDIRECT_URI=

# Upstash Redis (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer token all MCP clients must send to /api/mcp
MCP_AUTH_TOKEN=

# Base URL of your deployed app (no trailing slash).
# Used to build upload URLs returned by get_image_upload_link.
# Local (vercel dev):  http://localhost:3000
# Production (Vercel): https://<your-app>.vercel.app
APP_BASE_URL=

# Optional: static OAuth client credentials for Claude's "custom connector"
# Advanced settings. If you leave them blank, Claude will instead register a
# client dynamically via POST /oauth/register (fully supported).
# MCP_OAUTH_CLIENT_ID=
# MCP_OAUTH_CLIENT_SECRET=
# MCP_OAUTH_CLIENT_NAME=LinkedIn MCP
# MCP_OAUTH_SECRET=change-me-any-random-string