# LinkedIn OAuth app (https://www.linkedin.com/developers/apps)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Must match an Authorized Redirect URL in the LinkedIn app exactly.
# Local (vercel dev):  http://localhost:3000/api/callback
# Production (Vercel): https://<your-app>.vercel.app/api/callback
LINKEDIN_REDIRECT_URI=

# Upstash Redis (https://console.upstash.com)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Bearer token all MCP clients must send to /api/mcp
MCP_AUTH_TOKEN=